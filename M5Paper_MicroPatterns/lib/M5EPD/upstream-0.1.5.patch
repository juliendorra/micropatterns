+bool M5EPD_Canvas::pushCanvas1bpp(int32_t x, int32_t y,
+                                  m5epd_update_mode_t mode) {
+    if (!_created || _epd_driver == NULL) return false;
+
+    const uint8_t rot = _epd_driver->GetRotate();
+    int32_t px, py, pw, ph;
+
+    if (rot == IT8951_ROTATE_0) {
+        px = x;
+        py = y;
+        pw = _iwidth;
+        ph = _iheight;
+    } else if (rot == IT8951_ROTATE_90) {
+        px = y;
+        py = M5EPD_PANEL_H - _iwidth - x;
+        pw = _iheight;
+        ph = _iwidth;
+    } else {
+        return false;  // 180/270 unused by this project; not worked out
+    }
+
+    if (px < 0 || py < 0) return false;
+    if (px + pw > M5EPD_PANEL_W || py + ph > M5EPD_PANEL_H) return false;
+    if ((px % M5EPD_1BPP_ALIGN) || (pw % M5EPD_1BPP_ALIGN)) return false;
+
+    const uint32_t stride = (uint32_t)pw >> 3;
+    const uint32_t need   = stride * (uint32_t)ph;
+
+    if (_bitbuf == NULL || _bitbuf_size < need) {
+        free1bppBuffer();
+        // PSRAM first, deliberately. 64800 bytes of internal DRAM would be a
+        // permanent bite out of the same pool WiFi needs. The packing loop
+        // below is written so the only PSRAM-hostile accesses are one strided
+        // byte write per output byte.
+#if defined(BOARD_HAS_PSRAM)
+        _bitbuf = (uint8_t *)ps_malloc(need);
+#endif
+        if (_bitbuf == NULL) _bitbuf = (uint8_t *)malloc(need);
+        if (_bitbuf == NULL) {
+            log_e("pushCanvas1bpp: could not allocate %u bytes.",
+                  (unsigned)need);
+            return false;
+        }
+        _bitbuf_size = need;
+    }
+
+    // Pack. A SET bit means M5EPD_1BPP_FRONT_GREY (white by default), and the
+    // canvas convention -- shared with the 4bpp path, which complements on
+    // the way out -- is that grey 0 is white and grey 15 is black. So
+    // bit = (grey < 8). Anything in between is thresholded, not dithered.
+    if (rot == IT8951_ROTATE_0) {
+        for (int32_t cy = 0; cy < _iheight; cy++) {
+            const uint8_t *row = _img8 + (int32_t)cy * _bytewidth;
+            uint8_t *out       = _bitbuf + (uint32_t)cy * stride;
+            for (int32_t bx = 0; bx < (int32_t)stride; bx++) {
+                uint8_t b = 0;
+                for (int32_t k = 0; k < 8; k++) {
+                    const int32_t cx = (bx << 3) + k;
+                    const uint8_t v  = row[cx >> 1];
+                    const uint8_t g  = (cx & 1) ? (v & 0x0F) : (v >> 4);
+                    b                = (uint8_t)((b << 1) | (g < 8 ? 1 : 0));
+                }
+                out[bx] = b;
+            }
+        }
+    } else {
+        // Eight canvas rows at a time: eight sequential PSRAM read streams in,
+        // one byte written per canvas column out.
+        for (int32_t cy0 = 0; cy0 < _iheight; cy0 += 8) {
+            const uint8_t *rows[8];
+            int32_t n = _iheight - cy0;
+            if (n > 8) n = 8;
+            for (int32_t k = 0; k < n; k++) {
+                rows[k] = _img8 + (int32_t)(cy0 + k) * _bytewidth;
+            }
+            const uint32_t out_col = (uint32_t)cy0 >> 3;
+            for (int32_t cx = 0; cx < _iwidth; cx++) {
+                const uint32_t nb  = (uint32_t)cx >> 1;
+                const bool high    = ((cx & 1) == 0);
+                uint8_t b          = 0;
+                for (int32_t k = 0; k < 8; k++) {
+                    uint8_t bit = 1;  // pad short groups with white
+                    if (k < n) {
+                        const uint8_t v = rows[k][nb];
+                        const uint8_t g = high ? (v >> 4) : (v & 0x0F);
+                        bit             = (g < 8) ? 1 : 0;
+                    }
+                    b = (uint8_t)((b << 1) | bit);
+                }
+                _bitbuf[(uint32_t)(_iwidth - 1 - cx) * stride + out_col] = b;
+            }
+        }
+    }
+
+    if (_epd_driver->Write1bppGram(px, py, pw, ph, _bitbuf) != M5EPD_OK) {
+        return false;
+    }
+    if (_epd_driver->Update1bppArea(px, py, pw, ph, mode) != M5EPD_OK) {
+        return false;
+    }
+
+    _last_push_x = x;
+    _last_push_y = y;
+    return true;
 }
 
