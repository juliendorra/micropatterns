
DEFINE PATTERN NAME="artdeco" WIDTH=20 HEIGHT=20 DATA=""


VAR $center_x
VAR $center_y
VAR $secondplus
VAR $rotation
VAR $size

# fill background
COLOR NAME=BLACK
FILL NAME=SOLID
FILL_RECT WIDTH=$WIDTH HEIGHT=$HEIGHT X=0 Y=0

LET $center_x = $WIDTH / 2
LET $center_y = $HEIGHT / 2

TRANSLATE DX=$center_x DY=$center_y

LET $secondplus = 30 + $SECOND
LET $rotation = 360 * 89 / $secondplus
ROTATE DEGREES=$rotation

LET $size = 10 + $COUNTER % 10
VAR $halfsize = $size/2

FILL NAME="artdeco"
COLOR NAME=BLACK

REPEAT COUNT=$secondplus

 ROTATE DEGREES=$rotation

 VAR $radius = $INDEX * 10 % 50
 VAR $Xposition= $INDEX
 VAR $Yposition= $INDEX

 IF $INDEX % 2 == 0 THEN
  COLOR NAME=WHITE
  SCALE FACTOR=$size
 ELSE
  COLOR NAME=BLACK
  SCALE FACTOR=$halfsize
 ENDIF
 
 VAR $rectWidth= $INDEX*$WiDTH/10
  VAR $rectHeight= $INDEX*$HEIGHT/10
 
 FILL_RECT width=$rectWidth height=$rectWidth X=$Xposition Y=$Yposition
 
 #DRAW name="artdeco" x=$Xposition y=$Yposition
 
ENDREPEAT


