# City Map Generator - MicroPatterns DSL
DEFINE PATTERN NAME="street1" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="street2" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="street3" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="street4" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building1" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building2" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building3" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building4" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building5" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building6" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building7" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building8" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building9" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building10" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building11" WIDTH=20 HEIGHT=20 DATA=""
DEFINE PATTERN NAME="building12" WIDTH=20 HEIGHT=20 DATA=""

VAR $street1_prob = 40
VAR $street2_prob = 65
VAR $street3_prob = 85
VAR $street4_prob = 100

VAR $building1_prob = 5
VAR $building2_prob = 15
VAR $building3_prob = 25
VAR $building4_prob = 30
VAR $building5_prob = 40
VAR $building6_prob = 50
VAR $building7_prob = 60
VAR $building8_prob = 70
VAR $building9_prob = 75
VAR $building10_prob = 80
VAR $building11_prob = 90
VAR $building12_prob = 100

VAR $seed = $HOUR * 60 + $MINUTE + $COUNTER
VAR $time_factor = $SECOND * 3 + $MINUTE / 10
VAR $counter_mod = $COUNTER % 17

VAR $scale_random = $seed + $time_factor * 7 + $counter_mod * 11

# --- one pseudo-random stream for the whole render ---
# The modulus is prime, not 32768: with a power-of-two modulus the low bits of
# an LCG have very short periods, and both consumers below take a small modulo
# of the output. Largest intermediate is 32748 * 2053 + 13849, well inside a
# 32-bit int.
VAR $rng = $scale_random % 32749

# --- zoom range, derived from the panel ---
# A tile is 20*$scaling pixels. The top of the range is "one tile fills the
# width", never more: 200/20 = 10 on the small panel, clamped to 12 on a big
# one so it keeps its original 2..12 range.
VAR $max_scaling = $WIDTH / 20
IF $max_scaling > 12 THEN
    LET $max_scaling = 12
ENDIF
# The bottom of the range is 1 (a 20px tile) on a small panel. On a big panel a
# 20px tile is unreadable, so it stays at 2 as before.
VAR $min_scaling = 1
IF $WIDTH >= 400 THEN
    LET $min_scaling = 2
ENDIF
IF $max_scaling < $min_scaling THEN
    LET $max_scaling = $min_scaling
ENDIF
VAR $scale_steps = $max_scaling - $min_scaling + 1

# Draw a zoom level, then re-roll if it landed on one of the top two. They stay
# reachable, but a view showing only one or two tiles is now the exception:
# 4/steps^2 of renders instead of 2/steps.
VAR $rare_from = $scale_steps - 2
IF $rare_from < 1 THEN
    LET $rare_from = 1
ENDIF

LET $rng = $rng * 2053 + 13849
LET $rng = $rng % 32749
VAR $scale_pick = $rng / 8 % $scale_steps
IF $scale_pick >= $rare_from THEN
    LET $rng = $rng * 2053 + 13849
    LET $rng = $rng % 32749
    LET $scale_pick = $rng / 8 % $scale_steps
ENDIF
VAR $scaling = $min_scaling + $scale_pick

VAR $tilewidth = 20 * $scaling
VAR $grid_width = 1 + $WIDTH / $tilewidth
VAR $grid_height = 1 + $HEIGHT / $tilewidth

IF $grid_width < 1 THEN
    LET $grid_width = 1
ENDIF
IF $grid_height < 1 THEN
    LET $grid_height = 1
ENDIF

# When the panel is one or two tiles tall, row 0 is the whole picture. Row 0 is
# a street row by default, and a street tile blown up to 200px is mostly empty,
# so flip the parity and make it a building row instead.
# Only reachable on a small panel: a 540x960 grid is never this short.
VAR $row_phase = 0
IF $grid_height <= 2 THEN
    LET $row_phase = 1
ENDIF

VAR $x
VAR $y
VAR $is_street_row
VAR $pattern_choice
VAR $tile_type

COLOR NAME=WHITE
FILL NAME=SOLID
FILL_RECT X=0 Y=0 WIDTH=$WIDTH HEIGHT=$HEIGHT

REPEAT COUNT=$grid_height 
    LET $y = $INDEX
    LET $is_street_row = $y + $row_phase
    LET $is_street_row = $is_street_row % 2
    REPEAT COUNT=$grid_width
        LET $x = $INDEX 
        # One draw per tile, in visit order. The old picker was
        # $x*13 + $y*19 + $x*$y*7 + constants, which is affine in $x and $y:
        # tile types marched in arithmetic steps along every row and diagonal.
        LET $rng = $rng * 2053 + 13849
        LET $rng = $rng % 32749
        LET $tile_type = $rng / 8 % 100
        IF $is_street_row == 0 THEN
            IF $tile_type < $street1_prob THEN
                LET $pattern_choice = 100
            ENDIF
            IF $tile_type >= $street1_prob THEN
                IF $tile_type < $street2_prob THEN
                    LET $pattern_choice = 101
                ENDIF
            ENDIF
            IF $tile_type >= $street2_prob THEN
                IF $tile_type < $street3_prob THEN
                    LET $pattern_choice = 102
                ENDIF
            ENDIF
            IF $tile_type >= $street3_prob THEN
                LET $pattern_choice = 103
            ENDIF
        ENDIF
        IF $is_street_row == 1 THEN
            IF $tile_type < $building1_prob THEN
                LET $pattern_choice = 1
            ENDIF
            IF $tile_type >= $building1_prob THEN
                IF $tile_type < $building2_prob THEN
                    LET $pattern_choice = 2
                ENDIF
            ENDIF
            IF $tile_type >= $building2_prob THEN
                IF $tile_type < $building3_prob THEN
                    LET $pattern_choice = 3
                ENDIF
            ENDIF
            IF $tile_type >= $building3_prob THEN
                IF $tile_type < $building4_prob THEN
                    LET $pattern_choice = 4
                ENDIF
            ENDIF
            IF $tile_type >= $building4_prob THEN
                IF $tile_type < $building5_prob THEN
                    LET $pattern_choice = 5
                ENDIF
            ENDIF
            IF $tile_type >= $building5_prob THEN
                IF $tile_type < $building6_prob THEN
                    LET $pattern_choice = 6
                ENDIF
            ENDIF
            IF $tile_type >= $building6_prob THEN
                IF $tile_type < $building7_prob THEN
                    LET $pattern_choice = 7
                ENDIF
            ENDIF
            IF $tile_type >= $building7_prob THEN
                IF $tile_type < $building8_prob THEN
                    LET $pattern_choice = 8
                ENDIF
            ENDIF
            IF $tile_type >= $building8_prob THEN
                IF $tile_type < $building9_prob THEN
                    LET $pattern_choice = 9
                ENDIF
            ENDIF
            IF $tile_type >= $building9_prob THEN
                IF $tile_type < $building10_prob THEN
                    LET $pattern_choice = 10
                ENDIF
            ENDIF
            IF $tile_type >= $building10_prob THEN
                IF $tile_type < $building11_prob THEN
                    LET $pattern_choice = 11
                ENDIF
            ENDIF
            IF $tile_type >= $building11_prob THEN
                LET $pattern_choice = 12
            ENDIF
        ENDIF
        VAR $pixel_x = $x * 20
        VAR $pixel_y = $y * 20
        COLOR NAME=BLACK
        SCALE FACTOR=$scaling
        IF $pattern_choice >= 100 THEN
            IF $pattern_choice == 100 THEN
                DRAW NAME="street1" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 101 THEN
                DRAW NAME="street2" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 102 THEN
                DRAW NAME="street3" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 103 THEN
                DRAW NAME="street4" X=$pixel_x Y=$pixel_y
            ENDIF
        ENDIF
        IF $pattern_choice < 100 THEN
            IF $pattern_choice == 1 THEN
                DRAW NAME="building1" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 2 THEN
                DRAW NAME="building2" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 3 THEN
                DRAW NAME="building3" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 4 THEN
                DRAW NAME="building4" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 5 THEN
                DRAW NAME="building5" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 6 THEN
                DRAW NAME="building6" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 7 THEN
                DRAW NAME="building7" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 8 THEN
                DRAW NAME="building8" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 9 THEN
                DRAW NAME="building9" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 10 THEN
                DRAW NAME="building10" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 11 THEN
                DRAW NAME="building11" X=$pixel_x Y=$pixel_y
            ENDIF
            IF $pattern_choice == 12 THEN
                DRAW NAME="building12" X=$pixel_x Y=$pixel_y
            ENDIF
        ENDIF
        RESET_TRANSFORMS
    ENDREPEAT
ENDREPEAT
