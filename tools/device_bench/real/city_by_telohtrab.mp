# City Map Generator - MicroPatterns DSL
# Creates a procedural city layout using 8 different 20x20 tile patterns
# Adapts to any screen size using $WIDTH and $HEIGHT

# Define 8 city tile patterns (20x20 each)

# Pattern 1: Grass & Clouds
DEFINE PATTERN NAME="grass_clouds" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 2: HOUSE
DEFINE PATTERN NAME="house" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 3: ROAD WITH FENCE
DEFINE PATTERN NAME="road_with_fence" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 4: COW
DEFINE PATTERN NAME="cow" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 5: BUS STOP
DEFINE PATTERN NAME="bus_stop" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 6: TRAIN INCOMING
DEFINE PATTERN NAME="train" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 7: RAILS WITHOUT TRAIN
DEFINE PATTERN NAME="rails" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 8: SHOP
DEFINE PATTERN NAME="shop" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 9: GRASS ALTERNATIVE
DEFINE PATTERN NAME="grass_alt" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 10: CAR RIGHT
DEFINE PATTERN NAME="car_right" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 11: TREES
DEFINE PATTERN NAME="trees" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 12: PINE
DEFINE PATTERN NAME="pine" WIDTH=20 HEIGHT=20 DATA=""

# Pattern 12: BUS
DEFINE PATTERN NAME="bus" WIDTH=20 HEIGHT=20 DATA=""

# Variables for city generation with more randomness sources
VAR $seed = $HOUR * 60 + $MINUTE + $COUNTER
VAR $time_factor = $SECOND * 3 + $MINUTE / 10
VAR $counter_mod = $COUNTER % 17

VAR $scale_random = $seed + $time_factor * 7 + $counter_mod * 11
VAR $scaling = 2 + $scale_random % 11

VAR $tilewidth = 20 * $scaling
# Calculate grid dimensions (how many 20x20 scaled up tiles fit)
# add 1 to account for partial grids, avoid white borders
VAR $grid_width = 1 + $WIDTH / $tilewidth
VAR $grid_height = 1 + $HEIGHT / $tilewidth

# Ensure minimum grid size
IF $grid_width < 1 THEN
    LET $grid_width = 1
ENDIF
IF $grid_height < 1 THEN
    LET $grid_height = 1
ENDIF

VAR $x
VAR $y
VAR $tile_type
VAR $pattern_choice

# Fill background
COLOR NAME=WHITE
FILL NAME=SOLID
FILL_RECT X=0 Y=0 WIDTH=$WIDTH HEIGHT=$HEIGHT

# Generate city grid
REPEAT COUNT=$grid_height 

    LET $y = $INDEX * 2
    
    REPEAT COUNT=$grid_width
        LET $x = $INDEX 
        
        # Generate pseudo-random tile type with multiple randomness sources
        VAR $x_factor = $x * 13
        VAR $y_factor = $y * 19
        VAR $xy_cross = $x * $y * 7
        VAR $time_influence = $time_factor * 23
        VAR $counter_influence = $counter_mod * 31
        VAR $random_sum = $x_factor + $y_factor + $xy_cross + $seed + $time_influence + $counter_influence
        LET $tile_type = $random_sum % 100
                
        # Choose pattern based on tile_type value
        IF $tile_type < 8 THEN
            # grass clouds
            LET $pattern_choice = 1
        ENDIF
        
         IF $tile_type >= 8 THEN
            IF $tile_type < 25 THEN
                # grass alt
                LET $pattern_choice = 9
            ENDIF
        ENDIF
        
        IF $tile_type >= 25 THEN
            IF $tile_type < 40 THEN
                # house
                LET $pattern_choice = 2
            ENDIF
        ENDIF
        
        IF $tile_type >= 40 THEN
            IF $tile_type < 45 THEN
                # road with fence
                LET $pattern_choice = 3
            ENDIF
        ENDIF
        
        IF $tile_type >= 45 THEN
            IF $tile_type < 48 THEN
                # cow
                LET $pattern_choice = 4
            ENDIF
        ENDIF
        
        IF $tile_type >= 48 THEN
            IF $tile_type < 50 THEN
                # bus stop
                LET $pattern_choice = 5
            ENDIF
        ENDIF
        
        IF $tile_type >= 50 THEN
            IF $tile_type < 52 THEN
                # train
                LET $pattern_choice = 6
            ENDIF
        ENDIF
        
        IF $tile_type >= 52 THEN
            IF $tile_type < 55 THEN
                # rails
                LET $pattern_choice = 7
            ENDIF
        ENDIF
        
        IF $tile_type >= 55 THEN
            IF $tile_type < 65 THEN
                # car
                LET $pattern_choice = 10
            ENDIF
        ENDIF
        
        IF $tile_type >= 65 THEN
            IF $tile_type < 80 THEN
                # tree
                LET $pattern_choice = 11
            ENDIF
        ENDIF
        
        IF $tile_type >= 80 THEN
            IF $tile_type < 90 THEN
                # pine
                LET $pattern_choice = 12
            ENDIF
        ENDIF
        
         IF $tile_type >= 90 THEN
            IF $tile_type < 95 THEN
                # bus
                LET $pattern_choice = 13
            ENDIF
        ENDIF
        
        IF $tile_type >= 95 THEN
            # shop
            LET $pattern_choice = 8
        ENDIF
        
        # Calculate grid position (20x20 spacing)
        VAR $pixel_x = $x * 20
        VAR $pixel_y = $y * 20
        
        # Apply 4x scale 
        COLOR NAME=BLACK
        SCALE FACTOR=$scaling

        IF $pattern_choice == 1 THEN
            DRAW NAME="grass_clouds" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 2 THEN
            DRAW NAME="house" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 3 THEN
            DRAW NAME="road_with_fence" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 4 THEN
            DRAW NAME="cow" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 5 THEN
            DRAW NAME="bus_stop" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 6 THEN
            DRAW NAME="train" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 7 THEN
            DRAW NAME="rails" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 8 THEN
            DRAW NAME="shop" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 9 THEN
            DRAW NAME="grass_alt" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 10 THEN
            DRAW NAME="car_right" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 11 THEN
            DRAW NAME="trees" X=$pixel_x Y=$pixel_y
        ENDIF
        
        IF $pattern_choice == 12 THEN
            DRAW NAME="pine" X=$pixel_x Y=$pixel_y
        ENDIF
        
         IF $pattern_choice == 13 THEN
            DRAW NAME="bus" X=$pixel_x Y=$pixel_y
        ENDIF
        
        # Reset scale after drawing
        RESET_TRANSFORMS
        
    ENDREPEAT
ENDREPEAT