# New MicroPatterns Script
# the grid

DEFINE PATTERN NAME="stripes" WIDTH=8 HEIGHT=8 DATA="1000000100000000111111110000000010000001000000001110011100000000"

VAR $SIZE = $WIDTH + $WIDTH 
VAR $CENTERX = -1* $SIZE  / 2
VAR $CENTERY = -1* $SIZE / 2
VAR $SECONDPLUSONE = $SECOND + 1


COLOR NAME=BLACK
FILL NAME="stripes"

VAR $FACTOR = 2 + $COUNTER % 13
VAR $ANGLE= $FACTOR * 38567 % 360

ROTATE DEGREES=$ANGLE
SCALE FACTOR=$FACTOR

TRANSLATE DX=$CENTERX DY=$CENTERY

FILL_RECT X=0 Y=0 WIDTH=$SIZE HEIGHT=$SIZE
