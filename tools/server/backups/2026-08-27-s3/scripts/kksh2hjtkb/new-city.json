  "content": "# Simplified Random City Generator - MicroPatterns DSL\n# Pure random tile placement with equal weights for all 16 patterns\n\n# Define 16 tile patterns (20x20 each)\n\nDEFINE PATTERN NAME=\"tile01\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile02\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile03\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile04\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile05\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile06\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile07\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile08\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile09\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile10\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile11\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile12\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile13\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile14\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile15\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\nDEFINE PATTERN NAME=\"tile16\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# PROBABILITY CONFIGURATION - All equal weights (6.25% each)\nVAR $tile01_prob = 6\nVAR $tile02_prob = 12\nVAR $tile03_prob = 18\nVAR $tile04_prob = 25\nVAR $tile05_prob = 31\nVAR $tile06_prob = 37\nVAR $tile07_prob = 43\nVAR $tile08_prob = 50\nVAR $tile09_prob = 56\nVAR $tile10_prob = 62\nVAR $tile11_prob = 68\nVAR $tile12_prob = 75\nVAR $tile13_prob = 81\nVAR $tile14_prob = 87\nVAR $tile15_prob = 93\nVAR $tile16_prob = 100\n\n# Simple variables for randomness\nVAR $seed = $HOUR * 60 + $MINUTE + $COUNTER\nVAR $time_factor = $SECOND * 3 + $MINUTE\nVAR $counter_mod = $COUNTER % 17\n\nVAR $scale_random = $seed + $time_factor + $counter_mod\nVAR $scaling = 2 + $scale_random % 11\n\nVAR $tilewidth = 20 * $scaling\nVAR $grid_width = 1 + $WIDTH / $tilewidth\nVAR $grid_height = 1 + $HEIGHT / $tilewidth\n\nIF $grid_width < 1 THEN\n    LET $grid_width = 1\nENDIF\nIF $grid_height < 1 THEN\n    LET $grid_height = 1\nENDIF\n\nVAR $x\nVAR $y\nVAR $pattern_choice\n\nCOLOR NAME=WHITE\nFILL NAME=SOLID\nFILL_RECT X=0 Y=0 WIDTH=$WIDTH HEIGHT=$HEIGHT\n\nREPEAT COUNT=$grid_height \n    LET $y = $INDEX\n    \n    REPEAT COUNT=$grid_width\n        LET $x = $INDEX \n        \n        VAR $x_factor = $x * 13\n        VAR $y_factor = $y * 19\n        VAR $random_sum = $x_factor + $y_factor + $seed + $time_factor + $counter_mod\n        VAR $tile_type = $random_sum % 100\n        \n        IF $tile_type < $tile01_prob THEN\n            LET $pattern_choice = 1\n        ENDIF\n        IF $tile_type >= $tile01_prob THEN\n            IF $tile_type < $tile02_prob THEN\n                LET $pattern_choice = 2\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile02_prob THEN\n            IF $tile_type < $tile03_prob THEN\n                LET $pattern_choice = 3\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile03_prob THEN\n            IF $tile_type < $tile04_prob THEN\n                LET $pattern_choice = 4\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile04_prob THEN\n            IF $tile_type < $tile05_prob THEN\n                LET $pattern_choice = 5\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile05_prob THEN\n            IF $tile_type < $tile06_prob THEN\n                LET $pattern_choice = 6\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile06_prob THEN\n            IF $tile_type < $tile07_prob THEN\n                LET $pattern_choice = 7\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile07_prob THEN\n            IF $tile_type < $tile08_prob THEN\n                LET $pattern_choice = 8\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile08_prob THEN\n            IF $tile_type < $tile09_prob THEN\n                LET $pattern_choice = 9\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile09_prob THEN\n            IF $tile_type < $tile10_prob THEN\n                LET $pattern_choice = 10\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile10_prob THEN\n            IF $tile_type < $tile11_prob THEN\n                LET $pattern_choice = 11\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile11_prob THEN\n            IF $tile_type < $tile12_prob THEN\n                LET $pattern_choice = 12\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile12_prob THEN\n            IF $tile_type < $tile13_prob THEN\n                LET $pattern_choice = 13\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile13_prob THEN\n            IF $tile_type < $tile14_prob THEN\n                LET $pattern_choice = 14\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile14_prob THEN\n            IF $tile_type < $tile15_prob THEN\n                LET $pattern_choice = 15\n            ENDIF\n        ENDIF\n        IF $tile_type >= $tile15_prob THEN\n            LET $pattern_choice = 16\n        ENDIF\n        \n        VAR $pixel_x = $x * 20\n        VAR $pixel_y = $y * 20\n        \n        COLOR NAME=BLACK\n        SCALE FACTOR=$scaling\n\n        IF $pattern_choice == 1 THEN\n            DRAW NAME=\"tile01\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 2 THEN\n            DRAW NAME=\"tile02\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 3 THEN\n            DRAW NAME=\"tile03\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 4 THEN\n            DRAW NAME=\"tile04\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 5 THEN\n            DRAW NAME=\"tile05\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 6 THEN\n            DRAW NAME=\"tile06\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 7 THEN\n            DRAW NAME=\"tile07\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 8 THEN\n            DRAW NAME=\"tile08\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 9 THEN\n            DRAW NAME=\"tile09\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 10 THEN\n            DRAW NAME=\"tile10\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 11 THEN\n            DRAW NAME=\"tile11\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 12 THEN\n            DRAW NAME=\"tile12\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 13 THEN\n            DRAW NAME=\"tile13\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 14 THEN\n            DRAW NAME=\"tile14\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 15 THEN\n            DRAW NAME=\"tile15\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        IF $pattern_choice == 16 THEN\n            DRAW NAME=\"tile16\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        RESET_TRANSFORMS\n        \n    ENDREPEAT\nENDREPEAT",
