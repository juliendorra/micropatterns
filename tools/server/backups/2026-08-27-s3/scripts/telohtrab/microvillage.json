{
  "id": "microvillage",
  "name": "microvillage",
  "content": "# City Map Generator - MicroPatterns DSL\n# Creates a procedural city layout using 8 different 20x20 tile patterns\n# Adapts to any screen size using $WIDTH and $HEIGHT\n\n# Define 8 city tile patterns (20x20 each)\n\n# Pattern 1: Grass & Clouds\nDEFINE PATTERN NAME=\"grass_clouds\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 2: HOUSE\nDEFINE PATTERN NAME=\"house\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 3: ROAD WITH FENCE\nDEFINE PATTERN NAME=\"road_with_fence\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 4: COW\nDEFINE PATTERN NAME=\"cow\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 5: BUS STOP\nDEFINE PATTERN NAME=\"bus_stop\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 6: TRAIN INCOMING\nDEFINE PATTERN NAME=\"train\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 7: RAILS WITHOUT TRAIN\nDEFINE PATTERN NAME=\"rails\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 8: SHOP\nDEFINE PATTERN NAME=\"shop\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 9: GRASS ALTERNATIVE\nDEFINE PATTERN NAME=\"grass_alt\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 10: CAR RIGHT\nDEFINE PATTERN NAME=\"car_right\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 11: TREES\nDEFINE PATTERN NAME=\"trees\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 12: PINE\nDEFINE PATTERN NAME=\"pine\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Pattern 12: BUS\nDEFINE PATTERN NAME=\"bus\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Variables for city generation with more randomness sources\nVAR $seed = $HOUR * 60 + $MINUTE + $COUNTER\nVAR $time_factor = $SECOND * 3 + $MINUTE / 10\nVAR $counter_mod = $COUNTER % 17\n\nVAR $scale_random = $seed + $time_factor * 7 + $counter_mod * 11\nVAR $scaling = 2 + $scale_random % 11\n\nVAR $tilewidth = 20 * $scaling\n# Calculate grid dimensions (how many 20x20 scaled up tiles fit)\n# add 1 to account for partial grids, avoid white borders\nVAR $grid_width = 1 + $WIDTH / $tilewidth\nVAR $grid_height = 1 + $HEIGHT / $tilewidth\n\n# Ensure minimum grid size\nIF $grid_width < 1 THEN\n    LET $grid_width = 1\nENDIF\nIF $grid_height < 1 THEN\n    LET $grid_height = 1\nENDIF\n\nVAR $x\nVAR $y\nVAR $tile_type\nVAR $pattern_choice\n\n# Fill background\nCOLOR NAME=WHITE\nFILL NAME=SOLID\nFILL_RECT X=0 Y=0 WIDTH=$WIDTH HEIGHT=$HEIGHT\n\n# Generate city grid\nREPEAT COUNT=$grid_height \n\n    LET $y = $INDEX * 2\n    \n    REPEAT COUNT=$grid_width\n        LET $x = $INDEX \n        \n        # Generate pseudo-random tile type with multiple randomness sources\n        VAR $x_factor = $x * 13\n        VAR $y_factor = $y * 19\n        VAR $xy_cross = $x * $y * 7\n        VAR $time_influence = $time_factor * 23\n        VAR $counter_influence = $counter_mod * 31\n        VAR $random_sum = $x_factor + $y_factor + $xy_cross + $seed + $time_influence + $counter_influence\n        LET $tile_type = $random_sum % 100\n                \n        # Choose pattern based on tile_type value\n        IF $tile_type < 8 THEN\n            # grass clouds\n            LET $pattern_choice = 1\n        ENDIF\n        \n         IF $tile_type >= 8 THEN\n            IF $tile_type < 25 THEN\n                # grass alt\n                LET $pattern_choice = 9\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 25 THEN\n            IF $tile_type < 40 THEN\n                # house\n                LET $pattern_choice = 2\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 40 THEN\n            IF $tile_type < 45 THEN\n                # road with fence\n                LET $pattern_choice = 3\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 45 THEN\n            IF $tile_type < 48 THEN\n                # cow\n                LET $pattern_choice = 4\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 48 THEN\n            IF $tile_type < 50 THEN\n                # bus stop\n                LET $pattern_choice = 5\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 50 THEN\n            IF $tile_type < 52 THEN\n                # train\n                LET $pattern_choice = 6\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 52 THEN\n            IF $tile_type < 55 THEN\n                # rails\n                LET $pattern_choice = 7\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 55 THEN\n            IF $tile_type < 65 THEN\n                # car\n                LET $pattern_choice = 10\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 65 THEN\n            IF $tile_type < 80 THEN\n                # tree\n                LET $pattern_choice = 11\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 80 THEN\n            IF $tile_type < 90 THEN\n                # pine\n                LET $pattern_choice = 12\n            ENDIF\n        ENDIF\n        \n         IF $tile_type >= 90 THEN\n            IF $tile_type < 95 THEN\n                # bus\n                LET $pattern_choice = 13\n            ENDIF\n        ENDIF\n        \n        IF $tile_type >= 95 THEN\n            # shop\n            LET $pattern_choice = 8\n        ENDIF\n        \n        # Calculate grid position (20x20 spacing)\n        VAR $pixel_x = $x * 20\n        VAR $pixel_y = $y * 20\n        \n        # Apply 4x scale \n        COLOR NAME=BLACK\n        SCALE FACTOR=$scaling\n\n        IF $pattern_choice == 1 THEN\n            DRAW NAME=\"grass_clouds\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 2 THEN\n            DRAW NAME=\"house\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 3 THEN\n            DRAW NAME=\"road_with_fence\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 4 THEN\n            DRAW NAME=\"cow\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 5 THEN\n            DRAW NAME=\"bus_stop\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 6 THEN\n            DRAW NAME=\"train\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 7 THEN\n            DRAW NAME=\"rails\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 8 THEN\n            DRAW NAME=\"shop\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 9 THEN\n            DRAW NAME=\"grass_alt\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 10 THEN\n            DRAW NAME=\"car_right\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 11 THEN\n            DRAW NAME=\"trees\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        IF $pattern_choice == 12 THEN\n            DRAW NAME=\"pine\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n         IF $pattern_choice == 13 THEN\n            DRAW NAME=\"bus\" X=$pixel_x Y=$pixel_y\n        ENDIF\n        \n        # Reset scale after drawing\n        RESET_TRANSFORMS\n        \n    ENDREPEAT\nENDREPEAT",
  "lastModified": "2025-06-05T13:57:59.949Z"
}