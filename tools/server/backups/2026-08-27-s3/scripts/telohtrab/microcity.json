  "content": "# City Map Generator - MicroPatterns DSL\n# Creates a procedural city layout alternating between building rows and street rows\n# Adapts to any screen size using $WIDTH and $HEIGHT\n\n# Define 4 street tile patterns (20x20 each)\n\n# Street Pattern 1: ROAD WITH FENCE\nDEFINE PATTERN NAME=\"street1\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Street Pattern 2: TRAIN INCOMING\nDEFINE PATTERN NAME=\"street2\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Street Pattern 3: RAILS WITHOUT TRAIN\nDEFINE PATTERN NAME=\"street3\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Street Pattern 4: CAR RIGHT\nDEFINE PATTERN NAME=\"street4\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Define 12 building tile patterns (20x20 each)\n\n# Building Pattern 1: VERTICAL STREET\nDEFINE PATTERN NAME=\"building1\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 2: SHOP\nDEFINE PATTERN NAME=\"building2\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 3: BUS STOP\nDEFINE PATTERN NAME=\"building3\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 4: COW\nDEFINE PATTERN NAME=\"building4\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 5: GRASS & CLOUDS\nDEFINE PATTERN NAME=\"building5\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 6: GRASS ALTERNATIVE\nDEFINE PATTERN NAME=\"building6\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 7: TREES\nDEFINE PATTERN NAME=\"building7\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 8: PINE\nDEFINE PATTERN NAME=\"building8\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 9: BUS\nDEFINE PATTERN NAME=\"building9\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 10: HOUSE 2\nDEFINE PATTERN NAME=\"building10\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 11: SHOP 2\nDEFINE PATTERN NAME=\"building11\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# Building Pattern 12: MIXED\nDEFINE PATTERN NAME=\"building12\" WIDTH=20 HEIGHT=20 DATA=\"\"\n\n# PROBABILITY CONFIGURATION - Easy to modify\n# Street patterns probabilities (out of 100)\nVAR $street1_prob = 40\nVAR $street2_prob = 65\nVAR $street3_prob = 85\nVAR $street4_prob = 100\n\n# Building patterns probabilities (out of 100)\nVAR $building1_prob = 5\nVAR $building2_prob = 15\nVAR $building3_prob = 25\nVAR $building4_prob = 30\nVAR $building5_prob = 40\nVAR $building6_prob = 50\nVAR $building7_prob = 60\nVAR $building8_prob = 70\nVAR $building9_prob = 75\nVAR $building10_prob = 80\nVAR $building11_prob = 90\nVAR $building12_prob = 100\n\n# Variables for city generation with more randomness sources\nVAR $seed = $HOUR * 60 + $MINUTE + $COUNTER\nVAR $time_factor = $SECOND * 3 + $MINUTE / 10\nVAR $counter_mod = $COUNTER % 17\n\nVAR $scale_random = $seed + $time_factor * 7 + $counter_mod * 11\nVAR $scaling = 2 + $scale_random % 11\n\nVAR $tilewidth = 20 * $scaling\nVAR $grid_width = 1 + $WIDTH / $tilewidth\nVAR $grid_height = 1 + $HEIGHT / $tilewidth\n\nIF $grid_width < 1 THEN\n    LET $grid_width = 1\nENDIF\nIF $grid_height < 1 THEN\n    LET $grid_height = 1\nENDIF\n\nVAR $x\nVAR $y\nVAR $is_street_row\nVAR $pattern_choice\n\nCOLOR NAME=WHITE\nFILL NAME=SOLID\nFILL_RECT X=0 Y=0 WIDTH=$WIDTH HEIGHT=$HEIGHT\n\nREPEAT COUNT=$grid_height \n    LET $y = $INDEX\n    \n    LET $is_street_row = $y % 2\n    \n    REPEAT COUNT=$grid_width\n        LET $x = $INDEX \n        \n        VAR $x_factor = $x * 13\n        VAR $y_factor = $y * 19\n        VAR $xy_cross = $x * $y * 7\n        VAR $time_influence = $time_factor * 23\n        VAR $counter_influence = $counter_mod * 31\n        VAR $random_sum = $x_factor + $y_factor + $xy_cross + $seed + $time_influence + $counter_influence\n        VAR $tile_type = $random_sum % 100\n        \n        IF $is_street_row == 0 THEN\n            IF $tile_type < $street1_prob THEN\n                LET $pattern_choice = 100\n            ENDIF\n            IF $tile_type >= $street1_prob THEN\n                IF $tile_type < $street2_prob THEN\n                    LET $pattern_choice = 101\n                ENDIF\n            ENDIF\n            IF $tile_type >= $street2_prob THEN\n                IF $tile_type < $street3_prob THEN\n                    LET $pattern_choice = 102\n                ENDIF\n            ENDIF\n            IF $tile_type >= $street3_prob THEN\n                LET $pattern_choice = 103\n            ENDIF\n        ENDIF\n        \n        IF $is_street_row == 1 THEN\n            IF $tile_type < $building1_prob THEN\n                LET $pattern_choice = 1\n            ENDIF\n            IF $tile_type >= $building1_prob THEN\n                IF $tile_type < $building2_prob THEN\n                    LET $pattern_choice = 2\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building2_prob THEN\n                IF $tile_type < $building3_prob THEN\n                    LET $pattern_choice = 3\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building3_prob THEN\n                IF $tile_type < $building4_prob THEN\n                    LET $pattern_choice = 4\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building4_prob THEN\n                IF $tile_type < $building5_prob THEN\n                    LET $pattern_choice = 5\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building5_prob THEN\n                IF $tile_type < $building6_prob THEN\n                    LET $pattern_choice = 6\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building6_prob THEN\n                IF $tile_type < $building7_prob THEN\n                    LET $pattern_choice = 7\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building7_prob THEN\n                IF $tile_type < $building8_prob THEN\n                    LET $pattern_choice = 8\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building8_prob THEN\n                IF $tile_type < $building9_prob THEN\n                    LET $pattern_choice = 9\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building9_prob THEN\n                IF $tile_type < $building10_prob THEN\n                    LET $pattern_choice = 10\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building10_prob THEN\n                IF $tile_type < $building11_prob THEN\n                    LET $pattern_choice = 11\n                ENDIF\n            ENDIF\n            IF $tile_type >= $building11_prob THEN\n                LET $pattern_choice = 12\n            ENDIF\n        ENDIF\n        \n        VAR $pixel_x = $x * 20\n        VAR $pixel_y = $y * 20\n        \n        COLOR NAME=BLACK\n        SCALE FACTOR=$scaling\n\n        IF $pattern_choice >= 100 THEN\n            IF $pattern_choice == 100 THEN\n                DRAW NAME=\"street1\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 101 THEN\n                DRAW NAME=\"street2\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 102 THEN\n                DRAW NAME=\"street3\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 103 THEN\n                DRAW NAME=\"street4\" X=$pixel_x Y=$pixel_y\n            ENDIF\n        ENDIF\n        \n        IF $pattern_choice < 100 THEN\n            IF $pattern_choice == 1 THEN\n                DRAW NAME=\"building1\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 2 THEN\n                DRAW NAME=\"building2\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 3 THEN\n                DRAW NAME=\"building3\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 4 THEN\n                DRAW NAME=\"building4\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 5 THEN\n                DRAW NAME=\"building5\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 6 THEN\n                DRAW NAME=\"building6\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 7 THEN\n                DRAW NAME=\"building7\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 8 THEN\n                DRAW NAME=\"building8\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 9 THEN\n                DRAW NAME=\"building9\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 10 THEN\n                DRAW NAME=\"building10\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 11 THEN\n                DRAW NAME=\"building11\" X=$pixel_x Y=$pixel_y\n            ENDIF\n            IF $pattern_choice == 12 THEN\n                DRAW NAME=\"building12\" X=$pixel_x Y=$pixel_y\n            ENDIF\n        ENDIF\n        \n        RESET_TRANSFORMS\n        \n    ENDREPEAT\nENDREPEAT",
  "lastModified": "2025-06-05T13:56:45.992Z"
