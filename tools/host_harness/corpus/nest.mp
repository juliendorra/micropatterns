DEFINE PATTERN NAME="chk" WIDTH=4 HEIGHT=4 DATA="1010010110100101"
DEFINE PATTERN NAME="sol" WIDTH=2 HEIGHT=2 DATA="1111"
VAR $a = 0
VAR $b = 0
REPEAT COUNT=8
  LET $a = $INDEX
  REPEAT COUNT=6
    LET $b = $INDEX * 3 + $a % 4 - 1
    IF $b > 4 THEN
      FILL NAME=chk
      COLOR NAME=BLACK
      FILL_RECT X=$b Y=$a WIDTH=25 HEIGHT=15
    ELSE
      FILL NAME=SOLID
      COLOR NAME=WHITE
      DRAW NAME=sol X=$b Y=$a
    ENDIF
    TRANSLATE DX=12 DY=7
    DRAW NAME=chk X=$a Y=$b
  ENDREPEAT
  RESET_TRANSFORMS
ENDREPEAT
